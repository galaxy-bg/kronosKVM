[Unit]
Description=InfraBox dedicated GPIO power gestures
After=local-fs.target systemd-modules-load.service
ConditionPathExists=/etc/kronoskvm/power-button.enabled
ConditionPathExists=/etc/kronoskvm/power-button.env

[Service]
Type=simple
EnvironmentFile=/etc/kronoskvm/power-button.env
ExecStart=/usr/bin/python3 /opt/kronoskvm/scripts/power-button.py --pin ${KRONOSKVM_POWER_BUTTON_PIN}
RuntimeDirectory=kronoskvm-power-button
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/kronoskvm-power-button

[Install]
WantedBy=multi-user.target
