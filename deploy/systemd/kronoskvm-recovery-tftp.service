[Unit]
Description=KronosKVM read-only recovery TFTP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=10001
Group=20
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/opt/kronoskvm/config/recovery/dnsmasq-tftp.conf --pid-file=
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
